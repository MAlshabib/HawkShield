# HawkShield frontend environment
#
# Copy to `.env.local` (git-ignored) and adjust. Only variables prefixed with
# NEXT_PUBLIC_ reach the browser, and they are INLINED AT BUILD TIME — changing
# one requires a rebuild (`npm run build`) or a `next dev` restart.

# Base URL for the FastAPI backend.
#
#   ""                      -> same origin (PRODUCTION DEFAULT).
#                              FastAPI serves the static export from frontend/out
#                              at /, so the UI calls /attacks, /ask, ... directly.
#                              Leave empty or omit the variable entirely.
#
#   http://<pi-ip>:8000     -> laptop development (`npm run dev` on your machine,
#                              API running on the Pi). Requires the Pi's
#                              CORS_ORIGINS to include http://localhost:3000.
#
#   http://localhost:8000   -> API running locally alongside `npm run dev`.
NEXT_PUBLIC_API_BASE=
