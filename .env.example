# ==============================================================================
# HawkShield — environment configuration
# ==============================================================================
# Copy this file to `.env` in the REPO ROOT and edit it. `.env` is git-ignored;
# this file is the only one that gets committed, and it must never contain a
# real secret.
#
#     cp .env.example .env
#     nano .env          # set DATABASE_URL password + CAPTURE_IFACE, at minimum
#
# Loaded by pydantic-settings (backend/app/config.py) and, on the Pi, by systemd
# via `EnvironmentFile=/opt/hawkshield/.env`.
#
# systemd note: EnvironmentFile does NOT run a shell. Write `KEY=value` with no
# `export`, no command substitution, and no shell quoting unless the quotes are
# genuinely part of the value.
# ==============================================================================


# ------------------------------------------------------------------------------
# REQUIRED
# ------------------------------------------------------------------------------

# PostgreSQL connection. Must match the role/database created by
# deploy/postgres_setup.sql. CHANGE THE PASSWORD before first start — the
# default below is a placeholder, not a secret.
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://hawkshield:CHANGE_ME@localhost:5432/hawkshield

# Wi-Fi interface used for monitor-mode capture.
# This is almost always an EXTERNAL USB adapter (wlan1). The Pi 4's built-in
# wlan0 firmware generally does not support monitor mode — see deploy/README.md.
# Confirm the real name on your Pi with:  ip -br link
CAPTURE_IFACE=wlan1


# ------------------------------------------------------------------------------
# CAPTURE
# ------------------------------------------------------------------------------

# 2.4 GHz channel to pin the adapter to. Must match the channel of the network
# you are monitoring, and must match what deploy/monitor_mode.sh was given.
CAPTURE_CHANNEL=6

# Optional SSID filter. Empty = capture everything the radio hears.
TARGET_SSID=

# Detector -> DB batching. Rows are flushed when either bound is hit.
BATCH_SIZE=20
BATCH_FLUSH_SECONDS=2.0


# ------------------------------------------------------------------------------
# MODELS
# ------------------------------------------------------------------------------

# Directory holding the two joblib bundles. Defaults to <repo>/models; set an
# absolute path here if you keep the bundles outside the checkout.
MODEL_DIR=

STAGE1_MODEL=stage1_binary_bundle.joblib
STAGE2_MODEL=stage2_multiclass_bundle.joblib

# Decision thresholds. p1 < STAGE1_THRESHOLD -> drop as normal traffic.
# p2 < STAGE2_THRESHOLD -> drop as low-confidence. Raise to cut false positives,

# --- model selection (see docs/CONTRACT.md section 5) ---
# auto | v1 | v2-tcn | v2-gbdt   ("v2" still means v2-tcn)
# auto takes the first of v2-gbdt, v2-tcn, v1 whose artefact matches feature_spec.
# v2-gbdt is first because it won on the held-out test set: macro-F1 0.9907 vs the
# TCN's 0.9856, and 0.9999 vs 0.9644 on Krack. Set v2-tcn if lightgbm will not
# install (no aarch64 wheel on Raspberry Pi OS) or you are flash-bound: 348 KB
# against 3.0 MB. An explicit choice refuses to start on a mismatch instead of
# silently downgrading.
MODEL_VERSION=auto
V2_GBDT=hawkshield_v2_gbdt.txt
V2_MODEL=hawkshield_v2.onnx
V2_META=hawkshield_v2_meta.json
# Frames scored per inference call, both v2 targets. 32 is ~25x cheaper per frame
# than 1 for the TCN and ~2.7x for the GBDT, for <=32 frames of added delay.
V2_BATCH_FRAMES=32
# onnxruntime intra-op threads. 0 = runtime default (one per core), which is
# 2.4x SLOWER end to end for this workload. Leave it at 2 unless measured.
V2_ORT_THREADS=2
# LightGBM predict threads for v2-gbdt. Same reasoning as V2_ORT_THREADS: the
# library default is one thread per core, and the capture loop shares those cores.
GBDT_NUM_THREADS=2
# lower to catch more (and log more noise).
STAGE1_THRESHOLD=0.40
STAGE2_THRESHOLD=0.80


# ------------------------------------------------------------------------------
# OPTIONAL — RAG / natural-language `/ask`
# ------------------------------------------------------------------------------
# The assistant runs through OpenRouter (https://openrouter.ai), which speaks the
# OpenAI wire protocol. Get a key at https://openrouter.ai/keys.
# Everything else works without these: with OPENROUTER_API_KEY empty or unset the
# API starts normally and POST /ask returns HTTP 503; no other endpoint and no
# part of the dashboard is affected.

OPENROUTER_API_KEY=

# Model. Default is DeepSeek V4 Flash — strong at SQL generation and strict JSON,
# 1M context, roughly $0.08 in / $0.16 out per million tokens.
# Other good choices for this workload:
#   z-ai/glm-5.3-flash        (GLM 5.3 Flash, ~$0.075/$0.25)
#   qwen/qwen3.7-flash        (cheapest of the three, ~$0.03/$0.13)
#   qwen/qwen3-235b-a22b-2507 (largest, slower, ~$0.09/$0.55)
GEN_MODEL=deepseek/deepseek-v4-flash

HUMANIZE_SQL=1

# Optional: only change if you use a proxy or a self-hosted OpenAI-compatible API.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional attribution headers. OpenRouter uses these for its public app
# leaderboard; they have no effect on results. Defaults shown.
# OPENROUTER_SITE_URL=https://github.com/MAlshabib/HawkShield
# OPENROUTER_APP_NAME=HawkShield

# All three below are OPTIONAL and have working defaults — leave them alone
# unless you have a reason.

# LIMIT automatically appended to any unbounded SELECT that /ask generates, so a
# careless question cannot pull the whole packets table into memory.
# Deprecated: the agent reads SAQR_MAX_ROWS below and falls back to this.
RAG_MAX_ROWS=500

# Postgres statement_timeout (milliseconds) applied to /ask queries. Caps a
# runaway generated query instead of letting it pin the Pi's CPU.
# Deprecated: the agent reads SAQR_SQL_TIMEOUT_MS below and falls back to this.
RAG_SQL_TIMEOUT_MS=15000

# Override for the RAG knowledge base. Empty = use the packaged
# backend/app/rag/knowledge/attacks.md. Only set this to point at your own file.
ATTACKS_FILE=


# ------------------------------------------------------------------------------
# OPTIONAL — Saqr agent (POST /agent/ask)
# ------------------------------------------------------------------------------
# Saqr is the tool-calling assistant: instead of writing SQL, the model calls
# named tools (query_threats, aggregate_threats, threat_overview, ...) that run
# the same Python the dashboard endpoints run. It shares OPENROUTER_API_KEY with
# /ask above; with no key, /agent/ask returns HTTP 503 exactly as /ask does.
#
# Verify it before a demo:  python backend/scripts/check_saqr.py

# Master switch. 0 makes every /agent/* route answer 503 without calling out.
SAQR_ENABLED=1

# Model. MUST support tool calling. Blank = reuse GEN_MODEL above, so an .env
# written before the agent existed keeps working with no edit.
# Known-good: deepseek/deepseek-v4-flash, z-ai/glm-5.3-flash, qwen/qwen3.7-flash
SAQR_MODEL=

# en | ar. Used when the request body does not specify a locale. The Arabic
# prompt keeps MACs, SSIDs, interface names, channel numbers, the eight class
# identifiers and any SQL in Latin script so answers stay checkable against the
# dashboard.
SAQR_DEFAULT_LOCALE=en

# Sampling temperature. Low on purpose: this reports measurements, not prose.
SAQR_TEMPERATURE=0.1

# Loop budget. SAQR_MAX_STEPS model turns may call tools; exhausting them forces
# one final prose turn rather than a blank answer. SAQR_MAX_TOOL_CALLS is the
# total tool executions per question, across all steps.
SAQR_MAX_STEPS=6
SAQR_MAX_TOOL_CALLS=12

# Wall-clock budgets, in seconds: one whole question, and one tool inside it.
SAQR_RUN_TIMEOUT_S=90
SAQR_TOOL_TIMEOUT_S=20

# Row budgets. SAQR_MAX_ROWS is the LIMIT appended to an unbounded SELECT;
# SAQR_UI_ROWS is how many rows the API hands back for the results table;
# SAQR_MAX_TOOL_CHARS caps the JSON one tool result may add to the conversation
# so a wide query cannot eat the context window.
SAQR_MAX_ROWS=500
SAQR_UI_ROWS=50
SAQR_MAX_TOOL_CHARS=12000

# Postgres statement_timeout (ms) for agent SQL.
SAQR_SQL_TIMEOUT_MS=15000

# Publish the run_sql escape hatch (model-authored SELECT over `packets`, behind
# the read-only and table allow-list guards). Off by default: the seven
# structured tools cover the dashboard, and raw SQL is the widest surface here.
SAQR_ALLOW_RAW_SQL=0

# Publish run_simulation, the one tool that writes rows. Also requires
# ALLOW_SIMULATION=1. Per-class detections are capped at
# min(requested, SAQR_SIM_TOOL_MAX_COUNT, SIM_MAX_COUNT).
SAQR_ALLOW_SIMULATION_TOOL=1
SAQR_SIM_TOOL_MAX_COUNT=50

# Seconds between liveness beats while /agent/ask streams: one `status` event
# plus an SSE `: ka` comment. A model call routinely takes several seconds with
# nothing to report, and a silent stream is indistinguishable from a hung one --
# to the user watching the pane and to any reverse proxy's idle timer.
SAQR_STREAM_KEEPALIVE_S=15

# Rolling-window rate limit on /agent/ask, and how many runs may be in flight at
# once. Not security controls -- one uvicorn worker on a Pi 4 is the whole
# deployment, and an agent run is the most expensive thing it does.
SAQR_RATE_MAX=20
SAQR_RATE_WINDOW_S=60
SAQR_MAX_CONCURRENT_RUNS=2


# ------------------------------------------------------------------------------
# OPTIONAL — API / paths
# ------------------------------------------------------------------------------

# Comma-separated allowed origins. In the default single-process deployment the
# built frontend is served by FastAPI itself, so this only matters when running
# `next dev` on a laptop against the Pi.
CORS_ORIGINS=http://localhost:3000

# Built Next.js static export served at `/`. Defaults to <repo>/frontend/out.
FRONTEND_DIST=

# AP coordinates for the map view. Defaults to
# <repo>/backend/config/ap_locations.json.
AP_LOCATIONS_FILE=

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
