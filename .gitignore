# ==============================================================================
# HawkShield — .gitignore
# ==============================================================================
# Deliberately COMMITTED, do not add ignore rules for these:
#   models/*.joblib        the two LightGBM bundles (~2 MB) the detector loads
#   data/samples/*.pcapng  the six sample captures (~33 MB) used by tests/replay
# ==============================================================================

# --- Secrets / local config ---------------------------------------------------
# Ignore every .env variant, then un-ignore the committed template.
.env
.env.*
!.env.example

*.pem
*.key
secrets.json

# --- Python virtualenvs -------------------------------------------------------
.venv/
venv/
env/
fenv/
ENV/

# --- Python bytecode / build artifacts ----------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- Test / tooling caches ----------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/

# --- Node / Next.js frontend --------------------------------------------------
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# --- Archive ------------------------------------------------------------------
# 253 MB reference zip + its extraction. Read-only source material, never commit.
_archive/

# --- Logs / runtime -----------------------------------------------------------
*.log
logs/
*.pid
*.sqlite3
*.db-journal

# --- Captures produced at runtime ---------------------------------------------
# (data/samples/*.pcapng is committed on purpose and is not matched by these,
#  since these rules only cover the repo root and a scratch capture dir.)
/*.pcap
/*.pcapng
captures/

# --- OS cruft -----------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Editors ------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.orig
*.rej
*.bak

# --- Agent / assistant tooling -------------------------------------------------
# Local session + settings state only. CLAUDE.md itself stays committed if present.
.claude/
!CLAUDE.md

# --- Jupyter ------------------------------------------------------------------
# Notebooks in notebooks/ are committed (outputs stripped); checkpoints are not.
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Local dev databases (SQLite files used for laptop testing) ---------------
*.db
*.sqlite

# --- Generated output ---------------------------------------------------------
hawkshield_report_*.pdf
scratch/
tmp/
*.tmp

# AWID3 working data: multi-GB intermediates, regenerated by ml/prepare_awid3.py
_work/

# Serena tool cache
.serena/

# Training reports are regenerated by every run; only commit them alongside
# the model they describe, so a stale report can never outlive its weights.
ml/reports/*.md

# Local secrets reference (passwords) — never committed; lives on the host only
SECRETS.txt

# Thmanyah Sans — licensed font, obtained from the foundry, never redistributed here.
# Run `npm run fonts` in frontend/ to put it in place. See frontend/scripts/fonts.mjs.
frontend/public/fonts/thmanyah/
